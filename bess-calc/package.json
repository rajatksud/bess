{
  "name": "bess-roi-calculator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc && vite build",
    "build:server": "tsc -p server/tsconfig.json --noEmit && tsup",
    "build:all": "npm run build && npm run build:server",
    "start": "node server-dist/index.js",
    "lint": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "prisma:generate": "prisma generate",
    "db:migrate:staging": "node scripts/composeDatabaseUrl.mjs staging admin -- npx prisma migrate deploy",
    "db:migrate:prod": "node scripts/composeDatabaseUrl.mjs prod admin -- npx prisma migrate deploy",
    "db:status:staging": "node scripts/composeDatabaseUrl.mjs staging admin -- npx prisma migrate status",
    "db:status:prod": "node scripts/composeDatabaseUrl.mjs prod admin -- npx prisma migrate status"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "javascript-lp-solver": "^1.0.3",
    "lucide-react": "^0.475.0",
    "motion": "^12.4.2",
    "papaparse": "^5.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "prisma": "6.19.3",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.0.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
