# Environment Variables

# Frontend build-time only (Google AI Studio scaffold origin; not used by server/).
GEMINI_API_KEY=

# --- Server runtime (server/) ---
# Port the compiled Express server listens on.
PORT=8080
# Baked into the Docker image at build time (see Dockerfile); reported by
# GET /api/v1/version. Not required for local `npm run dev:server`.
APP_VERSION=
GIT_COMMIT_SHA=

# Node environment. Production containers should always set this to "production".
NODE_ENV=development

# --- Persistence (Prisma + PostgreSQL) ---
# Connection string used by the app at runtime (the new /api/v1/projects,
# /scenarios, /datasets, /simulations routes). Use the least-privilege
# application user, not the migration/admin user.
# Example: postgresql://<app_user>:<password>@localhost:5433/bess
DATABASE_URL=

# The discrete DB_STG_*/DB_PROD_* variables below are this repo's actual
# source of truth for staging/prod connection details (see
# docs/database/MIGRATION_GUIDE.md). scripts/composeDatabaseUrl.mjs composes
# DATABASE_URL from these at migration time so the admin credential never
# needs to be duplicated into a second format. Local dev against staging
# requires the pre-existing SSH tunnel (localhost:5433 -> staging Postgres)
# to already be running; this app does not open the tunnel itself.
DB_STG_HOST=
DB_STG_PORT=
DB_STG_NAME=
DB_STG_ADMIN_USER=
DB_STG_ADMIN_PASSWORD=
DB_STG_USER=
DB_STG_PASSWORD=
DB_PROD_HOST=
DB_PROD_PORT=
DB_PROD_NAME=
DB_PROD_ADMIN_USER=
DB_PROD_ADMIN_PASSWORD=
DB_PROD_USER=
DB_PROD_PASSWORD=
