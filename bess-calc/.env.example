# Environment Variables

# Frontend build-time only (Google AI Studio scaffold origin; not used by server/).
GEMINI_API_KEY=

# --- Server runtime (server/) ---
# Port the compiled Express server listens on.
PORT=8080
# Baked into the Docker image at build time (see Dockerfile); reported by
# GET /api/v1/version. Not required for local `npm run dev:server`.
APP_VERSION=
GIT_COMMIT_SHA=

# Node environment. Production containers should always set this to "production".
NODE_ENV=development
