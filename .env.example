# India tariff crawler (packages/india-tariffs/crawler) — environment reference.
# Copy to .env and fill in real values. Never commit .env.
#
# APP_ENV must match the environment marker recorded in the target database's
# deployment_metadata table (set automatically on first migration). The
# crawler refuses to run if these disagree — see src/db/env.ts.
APP_ENV=staging

# --- Staging database (local disposable Postgres, or a shared staging instance) ---
DB_STG_HOST=localhost
DB_STG_PORT=5544
DB_STG_NAME=tariff_crawler_staging
DB_STG_ADMIN_USER=tariff_crawler_admin
DB_STG_ADMIN_PASSWORD=change-me
DB_STG_USER=tariff_crawler_admin
DB_STG_PASSWORD=change-me

# --- Production database (set only on the prjxn2 deployment host, outside Git) ---
#DB_PROD_HOST=
#DB_PROD_PORT=
#DB_PROD_NAME=
#DB_PROD_USER=
#DB_PROD_PASSWORD=

# --- Disposable test database (integration tests only; destructive resets are
#     refused unless DB_TEST_* is set, or DB_STG_NAME ends with "_test") ---
#DB_TEST_HOST=localhost
#DB_TEST_PORT=5544
#DB_TEST_NAME=tariff_crawler_test
#DB_TEST_USER=tariff_crawler_admin
#DB_TEST_PASSWORD=change-me

CRAWLER_DATABASE_SCHEMA=tariff_crawler
DATABASE_SSLMODE=disable
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_SECONDS=60
