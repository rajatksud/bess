# India tariff crawler (packages/india-tariffs/crawler) — environment reference.
# Copy to .env and fill in real values. Never commit .env.
#
# APP_ENV must match the environment marker recorded in the target database's
# deployment_metadata table (set automatically on first migration). The
# crawler refuses to run if these disagree — see src/db/env.ts.
APP_ENV=staging

# --- Staging database ---
# A dedicated database on the shared staging Postgres instance, kept separate
# from other workstreams' databases on the same server (e.g. bess-calc's
# "bess" database) so migrations/tables never mix. Two roles are used:
# DB_STG_ADMIN_USER runs migrations (DDL); DB_STG_USER is a least-privilege
# role (SELECT/INSERT/UPDATE/DELETE on the tariff_crawler schema only, no
# DDL/superuser) used for registry loads, crawling and source-health checks.
DB_STG_HOST=localhost
DB_STG_PORT=5433
DB_STG_NAME=tariff_crawler_staging
DB_STG_ADMIN_USER=tariff_crawler_admin
DB_STG_ADMIN_PASSWORD=change-me
DB_STG_USER=tariff_crawler_user
DB_STG_PASSWORD=change-me

# --- Production database ---
# Set only on the prjxn2 deployment host via a server-side .env outside Git,
# never in this repo. See docs/operations/TARIFF_CRAWLER_DEPLOYMENT_PRJXN2.md.
#DB_PROD_HOST=localhost
#DB_PROD_PORT=15433
#DB_PROD_NAME=tariff_crawler
#DB_PROD_ADMIN_USER=
#DB_PROD_ADMIN_PASSWORD=
#DB_PROD_USER=
#DB_PROD_PASSWORD=

# --- Disposable test database (integration tests only) ---
# Destructive test operations are refused unless DB_TEST_* is set here, or
# DB_STG_NAME ends with "_test" — see loadTestDatabaseConfig() in
# src/db/env.ts. CI provisions its own disposable Postgres service; these
# are only needed for running integration tests against a local database.
#DB_TEST_HOST=localhost
#DB_TEST_PORT=5433
#DB_TEST_NAME=tariff_crawler_staging_test
#DB_TEST_USER=tariff_crawler_admin
#DB_TEST_PASSWORD=change-me

CRAWLER_DATABASE_SCHEMA=tariff_crawler
DATABASE_SSLMODE=disable
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_SECONDS=60

# --- Crawler deployment paths (set automatically inside the Docker image;
#     only needed if running the built dist/ output outside the container) ---
#CRAWLER_ARCHIVE_DIR=/app/data/.archive
#CRAWLER_PACKAGE_ROOT=/app
